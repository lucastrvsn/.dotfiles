alias h="history"
alias hg="history | rg"
alias h1="history 10"
alias h2="history 20"
alias h3="history 30"

if (( $+commands[nvim] )); then
  alias vi="nvim"
  alias vim="nvim"
fi

if [[ $OSTYPE == 'darwin'* ]]; then
  alias flush-dns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
  alias ic="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs"
fi

alias claude-ths="CLAUDE_CONFIG_DIR=~/.claude-ths /opt/homebrew/bin/claude"

